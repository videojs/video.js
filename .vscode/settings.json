{
  // Vite+ provides linting and formatting through Oxc.
  "eslint.enable": false,
  "biome.enabled": false,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",

  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.organizeImports": "never"
  },

  "editor.defaultFormatter": "oxc.oxc-vscode",
  "oxc.fmt.configPath": "./vite.config.ts",
  "npm.scriptRunner": "vp",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "css.validate": false,

  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[astro]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  // Enable Tailwind autocomplete for our custom *.styles.ts files
  "tailwindCSS.classFunctions": ["styles"],
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "tailwindCSS.experimental.configFile": {
    "packages/skins/src/styles/tailwind.compiler.css": "packages/skins/src/**",
    "apps/sandbox/app/styles.css": "apps/sandbox/**",
    "site/src/styles/globals.css": "site/**"
  }
}
