def calcul_score(nb_scenes, duree_s, video_ok, poster_ok, genre, scenes_ok):

    score = 0

    details = []

    if nb_scenes >= 60: score += 20; details.append("+20 scenes>=60")

    elif nb_scenes >= 30: score += 15; details.append("+15 scenes>=30")

    elif nb_scenes >= 15: score += 10; details.append("+10 scenes>=15")

    if duree_s >= 120: score += 20; details.append("+20 duree>=2min")

    elif duree_s >= 60: score += 15; details.append("+15 duree>=1min")

    elif duree_s >= 30: score += 10; details.append("+10 duree>=30s")

    if video_ok: score += 25; details.append("+25 video")

    if poster_ok: score += 10; details.append("+10 poster")

    if genre in GENRES: score += 10; details.append("+10 genre")

    if scenes_ok >= 20: score += 15; details.append("+15 scenes reussies")

    elif scenes_ok >= 10: score += 10; details.append("+10 scenes reussies")

    score = min(100, score)

    statut = "PITCHABLE" if score >= 70 else ("VIABLE" if score >= 50 else "BROUILLON")

    return {"score": score, "details": details, "statut": statut}





