            log("Poster : " + os.path.basename(dst))

        except Exception as e:

            log("Poster KO : " + str(e)[:80])



    archives = {}

    if resultats:

        with ETAT_LOCK:

            ETAT["statut"] = "compression"

        try:

            archives = compresser_dossier(frames_dir, film_id)

        except Exception as e:

            log("Compression KO : " + str(e)[:100])



    duree = video_result.get("duree_s", len(resultats) / float(fps)) if (video_result and video_result.get("ok")) else len(resultats) / float(fps)



    try:

        fiche = creer_fiche_netflix(film_id, scenario[:60], genre, scenario, scenes,

            video_result["chemin"] if (video_result and video_result.get("ok")) else "",

            poster_result["chemin"] if poster_result else "",

            duree, len(resultats))

    except Exception as e:

        log("Fiche KO : " + str(e)[:100])

        fiche = {"netflix_score": {"score": 0, "statut": "?"}}



    with ETAT_LOCK:

        ETAT["netflix_score"] = fiche.get("netflix_score", {}).get("score", 0)



    catalogue_path = os.path.join(DIR_CATALOGUE, "film_" + film_id + ".json")

    try:

        with open(catalogue_path, "w", encoding="utf-8") as f:

            json.dump(fiche, f, indent=2, ensure_ascii=False, default=str)

    except Exception as e:

        log("Catalogue KO : " + str(e)[:100])



    duree_totale = time.time() - ETAT["debut"]



    rapport = {

        "ok": True, "film_id": film_id, "titre": scenario[:60], "genre": genre,

        "nb_scenes": nb_scenes, "scenes_ok": len(resultats), "scenes_ko": len(erreurs),

        "duree_s": round(duree_totale, 2), "video": video_result,

        "poster": poster_result, "archives": archives,

        "fiche_netflix": fiche, "catalogue": catalogue_path, "erreurs": erreurs,

    }



    with ETAT_LOCK:

        ETAT["en_cours"] = False

        ETAT["progression"] = 100

        ETAT["statut"] = "termine"

        ETAT["film_final"] = video_result["chemin"] if (video_result and video_result.get("ok")) else ""

        ETAT["poster_final"] = poster_result["chemin"] if poster_result else ""



    log("=== FILM TERMINE ===")

    log("Duree : {:.1f}s".format(duree_totale))

    log("Score Netflix : {}".format(fiche.get("netflix_score", {}).get("score", 0)))



    return rapport





