def api_wikimedia(prompt, seed=None):

    search = urllib.parse.quote(prompt[:80])

    url = ("https://commons.wikimedia.org/w/api.php?"

           "action=query&format=json&generator=search&gsrsearch=" + search +

           "&gsrlimit=2&prop=imageinfo&iiprop=url&iiurlwidth=1024")

    try:

        req = urllib.request.Request(url, headers={"User-Agent": "NEXUS/7.0"})

        with urllib.request.urlopen(req, timeout=TIMEOUT, context=CTX) as r:

            data = json.loads(r.read().decode("utf-8", "ignore"))

        pages = data.get("query", {}).get("pages", {})

