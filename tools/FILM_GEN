def compresser_fichier(source, destination, methode="gzip"):

    try:

        if methode == "gzip":

            with open(source, "rb") as fi:

                with gzip.open(destination, "wb", compresslevel=9) as fo:

                    shutil.copyfileobj(fi, fo)

        elif methode == "bz2":

            with open(source, "rb") as fi:

                with bz2.open(destination, "wb", compresslevel=9) as fo:

                    shutil.copyfileobj(fi, fo)

        elif methode == "lzma":

            with open(source, "rb") as fi:

                with lzma.open(destination, "wb", preset=9) as fo:

                    shutil.copyfileobj(fi, fo)

        else:

            return False

        return os.path.isfile(destination)

    except Exception:

        return False





def compresser_dossier(dossier, film_id):

    if not os.path.isdir(dossier):

        return {}

    ts = time.strftime("%Y%m%d_%H%M%S")

    base = "film_" + film_id + "_" + ts

    resultats = {"gzip": {"total": 0, "fichiers": 0}, "bz2": {"total": 0, "fichiers": 0}, "lzma": {"total": 0, "fichiers": 0}, "prefix": base}

    fichiers = []

    try:

        for root, dirs, files in os.walk(dossier):

            for f in files:

                fichiers.append(os.path.join(root, f))

    except Exception:

        return resultats

    if not fichiers:

        return resultats

    for i, src in enumerate(fichiers):

        for methode, ext in (("gzip", ".gz"), ("bz2", ".bz2"), ("lzma", ".xz")):

            try:

                nom = "frame_{:05d}.png{}".format(i, ext)

                dst = os.path.join(DIR_ARCHIVES, base + "_" + nom)

                if compresser_fichier(src, dst, methode):

                    resultats[methode]["total"] += os.path.getsize(dst)

                    resultats[methode]["fichiers"] += 1

            except Exception:

                pass

    log("Archives : gz {} o | bz2 {} o | xz {} o".format(

        resultats["gzip"]["total"], resultats["bz2"]["total"], resultats["lzma"]["total"]))

    return resultats





