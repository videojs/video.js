def generer_film(scenario, genre="sci_fi", nb_scenes=15, fps=2):

    with ETAT_LOCK:

        if ETAT["en_cours"]:

            return {"ok": False, "erreur": "film deja en cours"}

        ETAT["en_cours"] = True

        ETAT["statut"] = "generation"

        ETAT["progression"] = 0

        ETAT["film_id"] = time.strftime("%Y%m%d_%H%M%S")

        ETAT["titre"] = scenario[:60]

        ETAT["genre"] = genre

        ETAT["total_scenes"] = nb_scenes

        ETAT["scenes_ok"] = 0

        ETAT["scenes_ko"] = 0

        ETAT["debut"] = time.time()

        ETAT["erreurs"] = []

        ETAT["log"] = []



    film_id = ETAT["film_id"]

    log("=== FILM {} ===".format(film_id))

    log("Genre : {} | Scenes : {} | FPS : {}".format(genre, nb_scenes, fps))



    frames_dir = os.path.join(DIR_FRAMES, film_id)

    try:

        os.makedirs(frames_dir, exist_ok=True)

    except Exception as e:

        with ETAT_LOCK:

            ETAT["en_cours"] = False

        return {"ok": False, "erreur": str(e)[:100]}



    scenes = construire_scenes(scenario, genre, nb_scenes)

    log("Architecture : {} scenes".format(len(scenes)))



    resultats = []

    erreurs = []



    try:

        with ThreadPoolExecutor(max_workers=MAX_THREADS) as ex:

            futurs = {}

            for i, s in enumerate(scenes):

                seed = 1000 + i + (abs(hash(scenario)) % 1000)

                futurs[ex.submit(generer_image, s["prompt"], seed)] = i



            for fut in as_completed(futurs):

                i = futurs[fut]

                try:

                    r = fut.result(timeout=180)

                except Exception as e:

                    r = {"ok": False, "erreur": str(e)[:100]}



                if r.get("ok"):

                    nom = "scene_{:05d}.png".format(i)

                    chemin = os.path.join(frames_dir, nom)

                    try:

                        with open(chemin, "wb") as f:

                            f.write(r["data"])

                        resultats.append({

                            "index": i, "beat": scenes[i]["beat"],

                            "chemin": chemin, "api": r["api"],

                            "taille": r["taille"], "sha256": r["sha256"],

                        })

                        with ETAT_LOCK:

                            ETAT["scenes_ok"] += 1

                    except Exception:

                        with ETAT_LOCK:

                            ETAT["scenes_ko"] += 1

                        erreurs.append("scene {} : ecriture KO".format(i))

                else:

                    with ETAT_LOCK:

                        ETAT["scenes_ko"] += 1

                    erreurs.append("scene {} : {}".format(i, r.get("erreur", "?")))



                with ETAT_LOCK:

                    done = ETAT["scenes_ok"] + ETAT["scenes_ko"]

                    ETAT["progression"] = int(100 * done / max(1, nb_scenes))

    except Exception as e:

        log("Erreur pipeline : " + str(e)[:150])



    log("Images OK : {} / {}".format(len(resultats), nb_scenes))



    video_result = None

    if resultats:

        with ETAT_LOCK:

            ETAT["statut"] = "video"

        try:

            video_result = creer_film_html(frames_dir, film_id, fps, scenario[:60], scenes)

        except Exception as e:

            log("Film HTML KO : " + str(e)[:100])



    poster_result = None

    if resultats:

        try:

            src = resultats[0]["chemin"]

            dst = os.path.join(DIR_POSTERS, "poster_" + film_id + ".png")

