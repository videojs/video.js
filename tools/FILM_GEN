def _ok_image(data):

    if not data or len(data) < 2000:

        return False

    return data[:4] == b"\x89PNG" or data[:2] == b"\xff\xd8"





def api_flux(prompt, seed=None):

    enc = urllib.parse.quote(prompt[:180])

    p = {"model": "flux", "width": "1024", "height": "1024", "nologo": "true"}

    if seed is not None:

        p["seed"] = str(seed)

    url = "https://image.pollinations.ai/prompt/" + enc + "?" + urllib.parse.urlencode(p)

    try:

        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 NEXUS/7.0", "Accept": "image/*"})

        with urllib.request.urlopen(req, timeout=TIMEOUT, context=CTX) as r:

            data = r.read()

        if _ok_image(data):

            return {"ok": True, "data": data, "api": "flux"}

    except Exception as e:

        return {"ok": False, "erreur": str(e)[:80], "api": "flux"}

