{
  "name": "@videojs/create-skin",
  "version": "10.1.0",
  "description": "Scaffold a local workbench for building your own Video.js 10 skin",
  "keywords": [
    "create",
    "scaffold",
    "skin",
    "theme",
    "video.js",
    "videojs"
  ],
  "homepage": "https://videojs.org/docs/framework/react/guides/build-your-own-skin",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/videojs/video.js.git",
    "directory": "packages/create-skin"
  },
  "bin": {
    "create-skin": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "create:local": "node --import tsx scripts/create-local.ts",
    "test": "vp run @videojs/create-skin#build && vp test run",
    "clean": "rimraf dist types '*.tsbuildinfo'"
  },
  "devDependencies": {
    "@clack/prompts": "1.2.0",
    "@types/node": "^22.18.6",
    "@videojs/core": "workspace:*",
    "@videojs/installation": "workspace:*",
    "@videojs/utils": "workspace:*",
    "vite-plus": "catalog:"
  }
}
