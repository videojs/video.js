{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": false,
    "jsx": "react-jsx",
    "jsxImportSource": "vjsc/components",
    "lib": ["ES2024"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../build/**/*.ts", "../build/**/*.tsx", "../vite.config.ts"],
  "exclude": ["presets"]
}
