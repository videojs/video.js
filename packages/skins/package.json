{
  "name": "@videojs/skins",
  "version": "10.1.0",
  "private": true,
  "description": "Canonical VJSC skin sources and delivery generators for Video.js",
  "keywords": [
    "css",
    "media",
    "skins",
    "tailwind",
    "videojs"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/video.js",
    "directory": "packages/skins"
  },
  "type": "module",
  "scripts": {
    "dev": "echo 'Preview skins in the sandbox: pnpm dev:sandbox, then pick Authored source.' && vp run generate:watch",
    "test": "pnpm run test:types && vp test run",
    "test:types": "tsgo --project ./src/tsconfig.json",
    "clean": "rimraf --glob dist types '*.tsbuildinfo'"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/caniuse-lite": "^1.0.5",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@videojs/core": "workspace:*",
    "@videojs/element": "workspace:*",
    "@videojs/icons": "workspace:*",
    "@videojs/installation": "workspace:*",
    "@videojs/utils": "workspace:*",
    "@vitejs/plugin-react": "^6.0.4",
    "browserslist": "^4.29.0",
    "caniuse-lite": "^1.0.30001810",
    "cn": "^0.2.5",
    "lightningcss": "catalog:",
    "oxfmt": "0.70.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vjsc": "workspace:*"
  }
}
