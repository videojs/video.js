{
  "name": "video.js",
  "version": "10.0.1",
  "description": "Points Video.js installs to @videojs/html and @videojs/react, and throws coded errors for Video.js 8 patterns",
  "keywords": [
    "media",
    "player",
    "videojs"
  ],
  "homepage": "https://videojs.org",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/video.js",
    "directory": "packages/video.js"
  },
  "files": [
    "AGENTS.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/default/index.js",
  "module": "dist/default/index.js",
  "types": "dist/dev/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/default/index.js"
    },
    "./errors": {
      "types": "./dist/dev/errors/index.d.ts",
      "development": "./dist/dev/errors/index.js",
      "default": "./dist/default/errors/index.js"
    },
    "./dist/video-js.css": "./dist/video-js.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:watch": "vp pack --watch ./src --no-clean",
    "dev": "pnpm run build:watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "clean": "rimraf --glob dist types '*.tsbuildinfo'"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1",
    "vite-plus": "catalog:"
  }
}
