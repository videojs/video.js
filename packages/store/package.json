{
  "name": "@videojs/store",
  "version": "10.0.0-rc.4",
  "description": "Reactive state management for external systems.",
  "keywords": [
    "media",
    "player",
    "reactive",
    "store",
    "videojs"
  ],
  "homepage": "https://videojs.org",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/v10",
    "directory": "packages/store"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/default/index.js",
  "module": "dist/default/index.js",
  "types": "dist/dev/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/default/index.js"
    },
    "./html": {
      "types": "./dist/dev/html.d.ts",
      "development": "./dist/dev/html.js",
      "default": "./dist/default/html.js"
    },
    "./react": {
      "types": "./dist/dev/react.d.ts",
      "development": "./dist/dev/react.js",
      "default": "./dist/default/react.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:watch": "vp pack --watch ./src --no-clean",
    "dev": "pnpm run build:watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "clean": "rimraf --glob dist types '*.tsbuildinfo'"
  },
  "dependencies": {
    "@videojs/utils": "workspace:*",
    "react-compiler-runtime": "^1.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.17",
    "@videojs/element": "workspace:*",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@videojs/element": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@videojs/element": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
