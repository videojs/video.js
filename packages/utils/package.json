{
  "name": "@videojs/utils",
  "version": "10.0.0-rc.4",
  "description": "Utility functions and helpers for Video.js",
  "keywords": [
    "media",
    "utils",
    "videojs"
  ],
  "homepage": "https://videojs.org",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/v10",
    "directory": "packages/utils"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./array": {
      "types": "./dist/array.d.ts",
      "default": "./dist/array.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./function": {
      "types": "./dist/function.d.ts",
      "default": "./dist/function.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "default": "./dist/jwt.js"
    },
    "./object": {
      "types": "./dist/object.d.ts",
      "default": "./dist/object.js"
    },
    "./predicate": {
      "types": "./dist/predicate.d.ts",
      "default": "./dist/predicate.js"
    },
    "./percent": {
      "types": "./dist/percent.d.ts",
      "default": "./dist/percent.js"
    },
    "./string": {
      "types": "./dist/string.d.ts",
      "default": "./dist/string.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "default": "./dist/style.js"
    },
    "./time": {
      "types": "./dist/time.d.ts",
      "default": "./dist/time.js"
    },
    "./number": {
      "types": "./dist/number.d.ts",
      "default": "./dist/number.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:watch": "vp pack --watch ./src --no-clean",
    "dev": "pnpm run build:watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "clean": "rimraf --glob dist types '*.tsbuildinfo'"
  },
  "devDependencies": {
    "jsdom": "^27.0.0",
    "vite-plus": "catalog:"
  }
}
