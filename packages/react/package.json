{
  "name": "@videojs/react",
  "version": "10.0.1",
  "description": "Video.js 10 for React: player components, skins, and hooks for video and audio",
  "keywords": [
    "audio",
    "components",
    "hooks",
    "media",
    "player",
    "react",
    "video",
    "video-player",
    "video.js",
    "videojs"
  ],
  "homepage": "https://videojs.org",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/v10",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*/i18n/locales/*/register.js"
  ],
  "main": "dist/default/index.js",
  "module": "dist/default/index.js",
  "types": "dist/dev/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/default/index.js"
    },
    "./ui/*-radio-group": {
      "types": "./dist/dev/ui/*-radio-group/index.d.ts",
      "development": "./dist/dev/ui/*-radio-group/index.js",
      "default": "./dist/default/ui/*-radio-group/index.js"
    },
    "./*.css": "./dist/default/*.css",
    "./icons": {
      "types": "./dist/dev/icons/index.d.ts",
      "development": "./dist/dev/icons/index.js",
      "default": "./dist/default/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/dev/icons/*/index.d.ts",
      "development": "./dist/dev/icons/*/index.js",
      "default": "./dist/default/icons/*/index.js"
    },
    "./extensions/*": {
      "types": "./dist/dev/extensions/*/index.d.ts",
      "development": "./dist/dev/extensions/*/index.js",
      "default": "./dist/default/extensions/*/index.js"
    },
    "./media/mux-video/hls-js": {
      "types": "./dist/dev/media/mux-video/hls-js.d.ts",
      "development": "./dist/dev/media/mux-video/hls-js.js",
      "default": "./dist/default/media/mux-video/hls-js.js"
    },
    "./media/mux-video/spf": {
      "types": "./dist/dev/media/mux-video/spf.d.ts",
      "development": "./dist/dev/media/mux-video/spf.js",
      "default": "./dist/default/media/mux-video/spf.js"
    },
    "./media/mux-audio/hls-js": {
      "types": "./dist/dev/media/mux-audio/hls-js.d.ts",
      "development": "./dist/dev/media/mux-audio/hls-js.js",
      "default": "./dist/default/media/mux-audio/hls-js.js"
    },
    "./media/mux-audio/spf": {
      "types": "./dist/dev/media/mux-audio/spf.d.ts",
      "development": "./dist/dev/media/mux-audio/spf.js",
      "default": "./dist/default/media/mux-audio/spf.js"
    },
    "./media/*": {
      "types": "./dist/dev/media/*/index.d.ts",
      "development": "./dist/dev/media/*/index.js",
      "default": "./dist/default/media/*/index.js"
    },
    "./video": {
      "types": "./dist/dev/presets/video/index.d.ts",
      "development": "./dist/dev/presets/video/index.js",
      "default": "./dist/default/presets/video/index.js"
    },
    "./video/*.css": "./dist/default/presets/video/*.css",
    "./video/*": {
      "types": "./dist/dev/presets/video/*.d.ts",
      "development": "./dist/dev/presets/video/*.js",
      "default": "./dist/default/presets/video/*.js"
    },
    "./audio": {
      "types": "./dist/dev/presets/audio/index.d.ts",
      "development": "./dist/dev/presets/audio/index.js",
      "default": "./dist/default/presets/audio/index.js"
    },
    "./audio/*.css": "./dist/default/presets/audio/*.css",
    "./audio/*": {
      "types": "./dist/dev/presets/audio/*.d.ts",
      "development": "./dist/dev/presets/audio/*.js",
      "default": "./dist/default/presets/audio/*.js"
    },
    "./background": {
      "types": "./dist/dev/presets/background/index.d.ts",
      "development": "./dist/dev/presets/background/index.js",
      "default": "./dist/default/presets/background/index.js"
    },
    "./background/*.css": "./dist/default/presets/background/*.css",
    "./background/*": {
      "types": "./dist/dev/presets/background/*.d.ts",
      "development": "./dist/dev/presets/background/*.js",
      "default": "./dist/default/presets/background/*.js"
    },
    "./live-video": {
      "types": "./dist/dev/presets/live-video/index.d.ts",
      "development": "./dist/dev/presets/live-video/index.js",
      "default": "./dist/default/presets/live-video/index.js"
    },
    "./live-video/*.css": "./dist/default/presets/live-video/*.css",
    "./live-video/*": {
      "types": "./dist/dev/presets/live-video/*.d.ts",
      "development": "./dist/dev/presets/live-video/*.js",
      "default": "./dist/default/presets/live-video/*.js"
    },
    "./live-audio": {
      "types": "./dist/dev/presets/live-audio/index.d.ts",
      "development": "./dist/dev/presets/live-audio/index.js",
      "default": "./dist/default/presets/live-audio/index.js"
    },
    "./live-audio/*.css": "./dist/default/presets/live-audio/*.css",
    "./live-audio/*": {
      "types": "./dist/dev/presets/live-audio/*.d.ts",
      "development": "./dist/dev/presets/live-audio/*.js",
      "default": "./dist/default/presets/live-audio/*.js"
    },
    "./i18n": {
      "types": "./dist/dev/i18n/index.d.ts",
      "development": "./dist/dev/i18n/index.js",
      "default": "./dist/default/i18n/index.js"
    },
    "./i18n/locales/*": {
      "types": "./dist/dev/i18n/locales/*.d.ts",
      "development": "./dist/dev/i18n/locales/*.js",
      "default": "./dist/default/i18n/locales/*.js"
    },
    "./i18n/text/*": {
      "types": "./dist/dev/i18n/text/*.d.ts",
      "development": "./dist/dev/i18n/text/*.js",
      "default": "./dist/default/i18n/text/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:watch": "vp pack --watch ./src --no-clean",
    "dev": "pnpm build:watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "clean": "rimraf --glob dist docs types '*.tsbuildinfo'",
    "prepack": "node --import tsx ../../site/scripts/copy-package-docs.ts react"
  },
  "dependencies": {
    "@videojs/core": "workspace:*",
    "@videojs/media": "workspace:*",
    "@videojs/native-hls-video": "workspace:*",
    "@videojs/spf": "workspace:*",
    "@videojs/store": "workspace:*",
    "@videojs/utils": "workspace:*",
    "react-compiler-runtime": "^1.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.17",
    "@videojs/cloudflare-video": "workspace:*",
    "@videojs/dash-video": "workspace:*",
    "@videojs/google-cast": "workspace:*",
    "@videojs/hlsjs-video": "workspace:*",
    "@videojs/icons": "workspace:*",
    "@videojs/mux-audio": "workspace:*",
    "@videojs/mux-data": "workspace:*",
    "@videojs/mux-video": "workspace:*",
    "@videojs/shaka-video": "workspace:*",
    "@videojs/spf": "workspace:*",
    "@videojs/spotify-audio": "workspace:*",
    "@videojs/tiktok-video": "workspace:*",
    "@videojs/twitch-video": "workspace:*",
    "@videojs/vimeo-video": "workspace:*",
    "@videojs/wistia-video": "workspace:*",
    "@videojs/youtube-video": "workspace:*",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@videojs/cloudflare-video": "workspace:*",
    "@videojs/dash-video": "workspace:*",
    "@videojs/google-cast": "workspace:*",
    "@videojs/hlsjs-video": "workspace:*",
    "@videojs/mux-audio": "workspace:*",
    "@videojs/mux-data": "workspace:*",
    "@videojs/mux-video": "workspace:*",
    "@videojs/shaka-video": "workspace:*",
    "@videojs/spotify-audio": "workspace:*",
    "@videojs/tiktok-video": "workspace:*",
    "@videojs/twitch-video": "workspace:*",
    "@videojs/vimeo-video": "workspace:*",
    "@videojs/wistia-video": "workspace:*",
    "@videojs/youtube-video": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@videojs/cloudflare-video": {
      "optional": true
    },
    "@videojs/dash-video": {
      "optional": true
    },
    "@videojs/google-cast": {
      "optional": true
    },
    "@videojs/hlsjs-video": {
      "optional": true
    },
    "@videojs/mux-audio": {
      "optional": true
    },
    "@videojs/mux-data": {
      "optional": true
    },
    "@videojs/mux-video": {
      "optional": true
    },
    "@videojs/shaka-video": {
      "optional": true
    },
    "@videojs/spotify-audio": {
      "optional": true
    },
    "@videojs/tiktok-video": {
      "optional": true
    },
    "@videojs/twitch-video": {
      "optional": true
    },
    "@videojs/vimeo-video": {
      "optional": true
    },
    "@videojs/wistia-video": {
