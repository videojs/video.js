{
  "name": "@videojs/mux-data",
  "version": "10.0.0-rc.4",
  "description": "Mux Data telemetry integration for Video.js",
  "keywords": [
    "analytics",
    "media",
    "mux",
    "telemetry",
    "videojs"
  ],
  "homepage": "https://videojs.org",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/v10",
    "directory": "packages/extensions/mux-data"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/default/index.js",
  "module": "dist/default/index.js",
  "types": "dist/dev/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/default/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:watch": "vp pack --watch ./src --no-clean",
    "dev": "pnpm run build:watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "clean": "rimraf --glob dist types '*.tsbuildinfo'"
  },
  "dependencies": {
    "@videojs/media": "workspace:*",
    "@videojs/utils": "workspace:*",
    "mux-embed": "5.17.10"
  },
  "devDependencies": {
    "@videojs/mux": "workspace:*",
    "dashjs": "5.2.0",
    "hls.js": "1.6.7",
    "jsdom": "^26.1.0",
    "vite-plus": "catalog:"
  }
}
