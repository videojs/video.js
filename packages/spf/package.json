{
  "name": "@videojs/spf",
  "version": "10.0.1",
  "description": "Stream Processing Framework for Video.js 10",
  "keywords": [
    "hls",
    "spf",
    "streaming",
    "video",
    "videojs"
  ],
  "homepage": "https://videojs.org",
  "license": "Apache-2.0",
  "repository": {
