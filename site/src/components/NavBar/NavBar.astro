---
import clsx from 'clsx';
import ArrowUpRight from '@/assets/icons/arrow-up-right.svg?react';
import Discord from '@/assets/logos/discord.svg?react';
import GitHub from '@/assets/logos/github.svg?react';
import Logo from '@/assets/logos/videojs.svg?react';
import AppearanceMenu from '@/components/AppearanceMenu';
import type { LinkDestination } from '@/components/typography/linkDestination';
import { DISCORD_INVITE_URL, GITHUB_REPO_URL } from '@/consts';
import Search from '../Search';
import GetStartedLink from './GetStartedLink';
import MobileNav from './MobileNav';

export interface Props {
  class?: string;
}

type NavLink = {
  href: string;
  label: string;
  matchPath: string | null;
  external?: boolean;
  destination?: LinkDestination;
};
const navLinks: NavLink[] = [
  { href: '/docs', label: 'Docs', matchPath: '/docs' },
  { href: '/blog', label: 'Blog', matchPath: '/blog', destination: 'blog' },
];

const currentPath = Astro.url.pathname;
const isDocsActive = currentPath.startsWith('/docs');
const otherNavLinks = navLinks.filter((link) => link.href !== '/docs');
const { class: className } = Astro.props;

const linkClass = clsx(
  "flex items-center gap-1 rounded-full px-3 py-1.5 font-display text-(length:--nav-text) uppercase transition-colors",
  "intent:bg-hover aria-[current=page]:bg-hover",
);
const iconClass = "flex size-9 items-center justify-center rounded-full opacity-80 transition intent:bg-hover intent:opacity-100";
---

<nav
  aria-label="Video.js"
  data-ph-capture-attribute-location="nav"
  style="--nav-text: 0.75rem"
  class:list={[
    "flex items-center gap-2 md:gap-3",
    "mx-auto w-full max-w-305 px-5 py-5 md:py-6",
    className,
  ]}
>
  <a href="/" class="mr-4 flex h-6 shrink-0 items-end lg:h-7">
    <Logo height="100%" />
    <span class="sr-only">Video.js video player</span>
  </a>
  {/* Desktop nav links */}
  <div class="hidden items-center gap-0.5 md:flex">
    <GetStartedLink
      client:idle
      className={linkClass}
      aria-current={isDocsActive ? "page" : undefined}
    >
      Docs
    </GetStartedLink>
    {
      otherNavLinks.map((link) => (
        <a
          href={link.href}
          data-ph-capture-attribute-destination={link.destination}
          aria-current={link.matchPath && currentPath.startsWith(link.matchPath) ? "page" : undefined}
          class={linkClass}
        >
          {link.label}{" "}
          {link.external ? (
            <ArrowUpRight className="size-3.5" aria-hidden="true" />
          ) : null}
        </a>
      ))
    }
  </div>
  <Search client:idle className="ml-auto sm:self-center" />
  <div class="hidden items-center md:flex">
    <AppearanceMenu client:idle />
    <a
      href={DISCORD_INVITE_URL}
      data-ph-capture-attribute-destination="discord"
      class={iconClass}
      aria-label="Discord"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Discord className="size-5" />
    </a>
    <a
      href={GITHUB_REPO_URL}
      data-ph-capture-attribute-destination="github"
      class={iconClass}
      aria-label="GitHub"
      target="_blank"
      rel="noopener noreferrer"
    >
      <GitHub className="size-5" />
    </a>
  </div>
  <GetStartedLink
    client:idle
    data-ph-capture-attribute-cta="get-started"
    className="hidden h-9 shrink-0 items-center rounded-full bg-faded-black px-4 font-display text-(length:--nav-text) text-manila-light uppercase transition-colors intent:bg-orange md:inline-flex dark:bg-manila-light dark:text-faded-black dark:intent:bg-orange"
  >
    Get started
  </GetStartedLink>

  <MobileNav client:idle navLinks={navLinks} currentPath={currentPath}>
    <slot name="mobile-nav" />
  </MobileNav>
</nav>
