---
import clsx from 'clsx';
import ArrowUpRight from '@/assets/icons/arrow-up-right.svg?react';
import Discord from '@/assets/logos/discord.svg?react';
import GitHub from '@/assets/logos/github.svg?react';
import Logo from '@/assets/logos/videojs.svg?react';
import CompactLogo from '@/assets/logos/vjs.svg?react';
import AppearanceMenu from '@/components/AppearanceMenu';
import BetaPill from '@/components/BetaPill';
import Search from '@/components/Search';
import type { LinkDestination } from '@/components/typography/linkDestination';
import { DISCORD_INVITE_URL, GITHUB_REPO_URL, VJS10_VERSION } from '@/consts';
import GetStartedLink from './GetStartedLink';
import MobileNav from './MobileNav';

export interface Props {
  class?: string;
}

type NavLink = {
  href: string;
  label: string;
  matchPath: string | null;
  external?: boolean;
  destination?: LinkDestination;
};
const navLinks: NavLink[] = [
  { href: '/docs', label: 'Docs', matchPath: '/docs' },
  { href: '/blog', label: 'Blog', matchPath: '/blog', destination: 'blog' },
];

const currentPath = Astro.url.pathname;
const isDocsActive = currentPath.startsWith('/docs');
const otherNavLinks = navLinks.filter((link) => link.href !== '/docs');
const { class: className } = Astro.props;
---

<nav
  aria-label="Video.js"
  data-ph-capture-attribute-location="nav-docs"
  class:list={[
    "sticky top-(--banner-height) z-30 mx-auto flex w-full items-center justify-between border-b border-b-manila-75 bg-manila-light px-5 dark:border-line dark:bg-faded-black",
    className,
  ]}
  style="height:var(--nav-h)"
>
  <a href="/" class="flex h-5 items-end gap-2 sm:h-6 sm:gap-3">
    <CompactLogo height="100%" className="xs:hidden w-auto" />
    <Logo height="100%" className="hidden xs:inline w-auto" />
    <span class="sr-only">Video.js video player</span>
    <BetaPill compact label={`v${VJS10_VERSION}`} />
  </a>
  <Search client:idle className="mr-2 xs:mr-4 ml-auto sm:self-center" />
  {/* Desktop nav links */}
  <div class="hidden h-full md:flex">
    <GetStartedLink
      client:idle
      className={clsx(
        "flex items-center rounded-md corner-squircle px-5 py-2 font-display text-h3 uppercase intent:bg-hover",
        isDocsActive ? "relative z-10 text-accent" : "",
      )}
      aria-current={isDocsActive ? "page" : undefined}
    >
      Docs
      <hr
        aria-hidden="true"
        class="absolute right-0 -bottom-px left-0 h-px bg-accent"
      />
    </GetStartedLink>
    {
      otherNavLinks.map((link) => (
        <a
          href={link.href}
          data-ph-capture-attribute-destination={link.destination}
          class:list={[
            "flex items-center rounded-md corner-squircle px-5 py-2 font-display text-h3 uppercase intent:bg-hover",
          ]}
        >
          {link.label}{" "}
          {link.external ? (
            <ArrowUpRight className="size-4" aria-hidden="true" />
          ) : null}
        </a>
      ))
    }
    <AppearanceMenu client:idle className="self-center" />
    <a
      href={DISCORD_INVITE_URL}
      data-ph-capture-attribute-destination="discord"
      class={clsx(
        "flex size-10 self-center items-center justify-center rounded-md corner-squircle intent:bg-hover",
      )}
      aria-label="Discord"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Discord className="size-6" />
    </a>
    <a
      href={GITHUB_REPO_URL}
      data-ph-capture-attribute-destination="github"
      class={clsx(
        "flex size-10 self-center items-center justify-center rounded-md corner-squircle intent:bg-hover",
      )}
      aria-label="GitHub"
      target="_blank"
      rel="noopener noreferrer"
    >
      <GitHub className="size-6" />
    </a>
  </div>

  <MobileNav client:idle navLinks={navLinks} currentPath={currentPath} compact>
    <BetaPill compact label={`v${VJS10_VERSION}`} slot="pill" />
    <slot name="mobile-nav" />
  </MobileNav>
</nav>
