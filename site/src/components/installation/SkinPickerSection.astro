---
import H3Markdown from '../typography/H3Markdown.astro';
import P from '../typography/P.astro';
import SkinPickerSectionClient from './SkinPickerSectionClient.tsx';

interface Props {
  includeNoSkin?: boolean;
  source?: boolean;
}

const { includeNoSkin = true, source = false } = Astro.props;
---

<div class="contents" data-installation-skin-section>
  <SkinPickerSectionClient client:idle includeNoSkin={includeNoSkin}>
    <H3Markdown id="choose-your-skin">Choose your skin</H3Markdown>
    <P>
      {
        source
          ? 'Choose the skin source the CLI will add to your project. You can edit its components, layout, styles, and interactions.'
          : 'Choose how your player looks. You can add the files for any skin to your project and edit them later.'
      }
    </P>
  </SkinPickerSectionClient>
</div>
