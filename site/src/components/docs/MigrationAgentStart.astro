---
import type { InstallationMigrationSource } from '@videojs/installation';

import AgentPrompt from '@/components/installation/AgentPrompt';
import P from '@/components/typography/P.astro';
import { DEFAULT_FRAMEWORK, resolveDocsFramework } from '@/types/docs';
import {
  agentPromptSelection,
  agentPromptTarget,
  agentPromptText,
  type AgentPromptGoal,
  type AgentPromptTask,
} from '@/utils/installation/agent-prompt';
import { DEFAULT_SELECTION } from '@/utils/installation/url-state';

interface Props {
  source: InstallationMigrationSource;
}

const { source } = Astro.props;
const framework = resolveDocsFramework(Astro.params.framework) ?? DEFAULT_FRAMEWORK;
const goal: AgentPromptGoal = `migrate-${source}`;
// The Markdown twin keeps the prompt the page starts with, since `agents init --from` carries the migration's steps.
const task: AgentPromptTask = { goal, request: '', features: [] };
const prompt = agentPromptText(
  agentPromptSelection(agentPromptTarget(null, framework), DEFAULT_SELECTION, task),
  { agent: null },
  task
);
---

<P>Copy this prompt into your coding agent to plan and run the migration.</P>

<div data-llms-ignore>
  <AgentPrompt client:idle route={null} framework={framework} goal={goal} />
</div>

<div hidden data-llms-only>
  <pre><code data-agent-prompt-markdown>{prompt}</code></pre>
</div>
