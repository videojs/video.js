---
import { getCollection } from 'astro:content';
import ChevronRight from '@/assets/icons/chevron-right.svg?react';
import Grid from '@/components/Grid.astro';
import { resolveDocsFramework } from '@/types/docs';
import { resolveDocsLinkUrl } from '@/utils/docs/routing';
import { getDocTitle } from '@/utils/docs/title';
import type { RelatedLink } from '@/utils/satteriRelatedLinks';

/**
 * Card grid for the "Related …" sections at the end of guides. `satteriRelatedLinks` produces it from the authored
 * DocsLink list; each card adds the target page's description.
 */
interface Props {
  /** JSON-encoded `RelatedLink[]`, serialised by the MDAST plugin. */
  items: string;
  /** Group name shown above the grid, such as "Components" or "Guides". */
  label?: string;
}

const routeFramework = Astro.params.framework;
const paramFramework = resolveDocsFramework(routeFramework);
if (!paramFramework) throw new Error(`Invalid or missing framework param "${routeFramework ?? 'undefined'}".`);

// SAFETY: the plugin is the only producer of this attribute and always serialises `RelatedLink[]`.
const items = (JSON.parse(Astro.props.items) as RelatedLink[]).filter(
  (item) => !item.frameworks || item.frameworks.includes(paramFramework)
);
const { label } = Astro.props;
const docs = await getCollection('docs');
const docsById = new Map(docs.map((doc) => [doc.id, doc]));

const cards = items.map((item) => {
  const { url } = resolveDocsLinkUrl({ targetSlug: item.slug, contextFramework: paramFramework });
  const doc = docsById.get(item.slug);
  // Reference pages are titled per framework (`PlayButton` vs `media-play-button`); match the page the card opens.
  const label = doc && item.slug.startsWith('reference/') ? getDocTitle(doc, paramFramework) : item.label;

  return {
    href: item.anchor ? `${url}#${item.anchor}` : url,
    label,
    description: doc?.data.description,
  };
});
---

{cards.length > 0 && (
<section class="mx-auto my-6 w-full max-w-3xl" data-ph-capture-attribute-location="related-links">
  {label && <h3 class="mb-3 font-display text-h4 uppercase text-muted select-none">{label}</h3>}
  <Grid as="ul" class="sm:grid-cols-2">
  {
    cards.map((card) => (
      <li class="docs-link-card">
        <a
          href={card.href}
          class="flex h-full items-center justify-between gap-4 rounded-lg corner-squircle border border-manila-dark p-4 no-underline dark:border-line intent:bg-manila-75 dark:intent:bg-warm-gray"
        >
          <span class="min-w-0">
            <span class="block font-semibold">{card.label}</span>
            {card.description && <span class="mt-1 line-clamp-2 block text-p3 dark:text-muted">{card.description}</span>}
          </span>
          <ChevronRight className="size-4 shrink-0 text-muted" aria-hidden="true" />
        </a>
      </li>
    ))
  }
  </Grid>
</section>
)}
