---
import type { HTMLAttributes } from 'astro/types';
import ChevronRight from '@/assets/icons/chevron-right.svg?react';
import { resolveDocsFramework, type SupportedFramework } from '@/types/docs';
import { resolveDocsHref } from '@/utils/docs/routing';
import { findGuideBySlug } from '@/utils/docs/sidebar';
import { twMerge } from '@/utils/twMerge';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  slug: string;
  /** Heading ID within the target guide. */
  anchor?: string;
  description?: string;
  /** Pin a link rendered inside a multi-framework page to one framework. */
  framework?: SupportedFramework;
  /** Carry the current installation choices into a Shadcn guide link. */
  preserveInstallationSelection?: boolean;
}
const {
  slug,
  anchor,
  description,
  framework: explicitFramework,
  preserveInstallationSelection = false,
  class: className,
} = Astro.props;

const routeFramework = Astro.params.framework;
const registryFrameworkSelection = routeFramework === 'shadcn';
const paramFramework = registryFrameworkSelection ? null : resolveDocsFramework(routeFramework);

if (routeFramework && !registryFrameworkSelection && !paramFramework) {
  throw new Error(`Invalid framework param "${routeFramework}".`);
}

if (!findGuideBySlug(slug)) {
  throw new Error(`No guide found with slug "${slug}"`);
}

// The query-controlled Shadcn route uses React as a valid server fallback. `data-docs-slug` lets ResolveDocsLinks
// follow the live React or HTML preference on the client; outside docs it upgrades the agnostic fallback the same way.
const contextFramework = explicitFramework ?? paramFramework ?? (registryFrameworkSelection ? 'react' : null);
const url = resolveDocsHref({ slug, framework: contextFramework });
const href = anchor ? `${url}#${anchor}` : url;
const docsSlug = explicitFramework || paramFramework ? undefined : slug;
---

<div
  data-ph-capture-attribute-location="docs-link-cards"
  class={twMerge(
    "docs-link-card mx-auto my-8 grid w-full max-w-3xl grid-cols-1 gap-4 has-[+_.docs-link-card]:mb-4 md:grid-cols-2 [&+.docs-link-card]:mt-4",
    className,
  )}
>
  <a
    href={href}
    data-docs-slug={docsSlug}
    data-installation-method-link={preserveInstallationSelection ? 'shadcn' : undefined}
    class="flex h-full items-center justify-between gap-4 rounded-lg corner-squircle border border-manila-dark p-4 no-underline md:pl-6 dark:border-line intent:bg-manila-75 dark:intent:bg-warm-gray"
  >
    {
      description ? (
        <div>
          <div class="font-semibold">
            <slot />
          </div>
          <div class="mt-2 text-p3 dark:text-muted">{description}</div>
        </div>
      ) : (
        <span>
          <slot />
        </span>
      )
    }
    <ChevronRight className="size-4 shrink-0 text-muted" aria-hidden="true" />
  </a>
</div>
