---
import clsx from 'clsx';

import BookIcon from '@/assets/icons/book.svg?react';
import CodeIcon from '@/assets/icons/code.svg?react';
import PuzzleIcon from '@/assets/icons/puzzle.svg?react';
import PenIcon from '@/assets/icons/pen.svg?react';
import SidebarItem from '@/components/docs/SidebarItem.astro';
import type { DocStability, SidebarItem as SidebarItemType, SupportedFramework } from '@/types/docs';
import { isLink, isSection } from '@/types/docs';
import { filterSidebar } from '@/utils/docs/sidebar';
import { isDocsGuideActive } from '@/utils/docs/routing';

type Props = {
  framework: SupportedFramework;
  docTitles: Map<string, string>;
  docStabilities: Map<string, DocStability | undefined>;
  class?: string;
  /**
   * Give the active link's indicator a view-transition name so it slides between pages of the same section. Only one
   * rendered sidebar per page may opt in; duplicate names would cancel the transition.
  */
  animateIndicator?: boolean;
};

const {
  framework,
  docTitles,
  docStabilities,
  class: className,
  animateIndicator = false,
} = Astro.props;
const filteredSidebar = filterSidebar(framework);
const currentPath = Astro.url.pathname;

function containsActivePath(item: SidebarItemType): boolean {
  if (isSection(item)) return item.contents.some(containsActivePath);

  if (isLink(item)) return false;

  return isDocsGuideActive(framework, item.slug, currentPath);
}

// Top-level sections are the sidebar's tabs. Every section's tree is rendered so switching tabs only swaps the visible
// tree, keeping the reader on the current page (and the mobile menu open). The section that contains the current page
// starts selected; fall back to the first so index-style pages still show a navigation tree.
const tabs = filteredSidebar.filter(isSection);
const looseItems = filteredSidebar.filter((item) => !isSection(item));
const activeTab = tabs.find(containsActivePath) ?? tabs[0];

// Scoped to the section so switching sections fades instead of sliding the indicator across unrelated lists.
const indicatorTransitionName =
  animateIndicator && activeTab
    ? `sidebar-indicator-${activeTab.sidebarLabel.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
    : undefined;

// View transition names that slide the pill between tabs. The animated sidebar keeps them so the pill also moves across
// page navigations; `section-tabs` lends them to other sidebars only while a tab switches in place, because a mobile
// menu that is gone after navigating would otherwise leave its tabs fading over the next page. Framework changes
// temporarily disable these names so the sidebar updates atomically.
const pillTransitionName = 'sidebar-tab-pill';
const labelTransitionName = (slug: string) => `sidebar-tab-${slug}`;
const transitionStyle = (name: string, extra = '') =>
  [animateIndicator && `view-transition-name: ${name}`, extra].filter(Boolean).join('; ') || undefined;
const tabSlug = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, '-');
// Layouts render one sidebar per placement and framework, so tab and panel IDs need both to stay unique.
const idPrefix = `docs-sidebar-${framework}-${animateIndicator ? 'aside' : 'menu'}`;

const TAB_ICONS = {
  Guides: BookIcon,
  Components: PuzzleIcon,
  API: CodeIcon,
  'Writing Style': PenIcon,
} satisfies Record<string, typeof BookIcon>;
---

<div
  class={clsx("bg-manila-light dark:bg-faded-black", className)}
  data-ph-capture-attribute-location="docs-sidebar"
>
  <slot />
  {
    tabs.length > 1 && (
      <div class="px-6 pt-5">
        <div
          role="tablist"
          aria-label="Docs sections"
          aria-orientation="vertical"
          data-docs-section-tabs
          class="mx-auto grid w-full max-w-3xl gap-1 rounded-lg corner-squircle border border-line bg-surface p-1"
        >
          {tabs.map((tab) => {
            const isActive = tab === activeTab;
            const Icon = TAB_ICONS[tab.sidebarLabel as keyof typeof TAB_ICONS];
            const slug = tabSlug(tab.sidebarLabel);

            return (
              <button
                type="button"
                role="tab"
                id={`${idPrefix}-tab-${slug}`}
                aria-controls={`${idPrefix}-panel-${slug}`}
                aria-selected={isActive ? "true" : "false"}
                tabindex={isActive ? 0 : -1}
                class:list={[
                  // One weight for both states prevents a layout shift when the selected section changes.
                  "group relative isolate flex cursor-pointer items-center rounded-md corner-squircle px-3 py-2 text-left text-p3 leading-5 font-medium select-none",
                  "text-muted intent:text-faded-black dark:intent:text-manila-light aria-selected:text-faded-black dark:aria-selected:text-manila-light",
                  "focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-gold",
                ]}
              >
                <span
                  aria-hidden="true"
                  data-docs-view-transition
                  data-docs-tab-transition={pillTransitionName}
                  class="absolute inset-0 -z-10 hidden rounded-md corner-squircle bg-surface-raised shadow-xs ring-1 ring-line group-aria-selected:block"
                  style={transitionStyle(pillTransitionName)}
                />
                <span
                  class="flex flex-1 items-center gap-2.5"
                  data-docs-view-transition
                  data-docs-tab-transition={labelTransitionName(slug)}
                  style={transitionStyle(labelTransitionName(slug), 'view-transition-class: sidebar-tab-label')}
                >
                  {Icon && (
                    <Icon className="size-4 shrink-0 opacity-70 group-aria-selected:opacity-100" aria-hidden="true" />
                  )}
                  <span class="flex-1">{tab.sidebarLabel}</span>
                  {tab.devOnly && (
                    <span class="rounded-md corner-squircle bg-surface-raised px-1.5 py-0.5 text-p4 leading-none font-medium text-muted ring-1 ring-line">
                      dev only
                    </span>
                  )}
                </span>
              </button>
            );
          })}
        </div>
      </div>
    )
  }
  <nav aria-label="Docs sidebar" class="px-6 pt-8 pb-6">
    {
      tabs.length > 1
        ? tabs.map((tab) => {
            const slug = tabSlug(tab.sidebarLabel);
            const isActive = tab === activeTab;

            return (
              <div
                role="tabpanel"
                id={`${idPrefix}-panel-${slug}`}
                aria-labelledby={`${idPrefix}-tab-${slug}`}
                hidden={!isActive}
              >
                {tab.contents.map((item) => (
                  <SidebarItem
                    item={item}
                    framework={framework}
                    docTitles={docTitles}
                    docStabilities={docStabilities}
                    indicatorTransitionName={isActive ? indicatorTransitionName : undefined}
                  />
                ))}
              </div>
            );
          })
        : activeTab?.contents.map((item) => (
            <SidebarItem
              item={item}
              framework={framework}
              docTitles={docTitles}
              docStabilities={docStabilities}
              indicatorTransitionName={indicatorTransitionName}
            />
          ))
    }
    {
      looseItems.map((item) => (
        <SidebarItem item={item} framework={framework} docTitles={docTitles} docStabilities={docStabilities} />
      ))
    }
  </nav>
</div>

<script>
  import { initializeDocsSectionTabs } from '@/utils/docs/section-tabs';

  initializeDocsSectionTabs();
</script>

<style is:global>
  /* Keep the morphing pill beneath the labels while the page transition runs. */
  ::view-transition-group(sidebar-tab-pill) {
    z-index: 1;
  }

  ::view-transition-group(.sidebar-tab-label) {
    z-index: 2;
  }

  /* Framework switches replace the whole sidebar. Suppress named snapshots for that navigation to avoid flashes. */
  html[data-docs-framework-navigation] [data-docs-view-transition] {
    view-transition-name: none !important;
  }
</style>
