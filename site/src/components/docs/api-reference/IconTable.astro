---
/**
 * Table of the packaged icons: a preview from each set beside the names readers import or pass to `<media-icon>`.
 *
 * Rows come from the public HTML string exports, so the table follows the icon build without a hand-kept list.
 */
import * as scaffoldIcons from '@videojs/html/icons/scaffold';
import * as compatIcons from '@videojs/html/icons/compat';
import * as defaultIcons from '@videojs/html/icons/default';
import * as neutralIcons from '@videojs/html/icons/neutral';

import MarkdownCode from '@/components/typography/MarkdownCode.astro';
import Table from '@/components/typography/Table.astro';
import Tbody from '@/components/typography/Tbody.astro';
import Td from '@/components/typography/Td.astro';
import Th from '@/components/typography/Th.astro';
import Thead from '@/components/typography/Thead.astro';
import Tr from '@/components/typography/Tr.astro';
import { resolveDocsFramework } from '@/types/docs';

const framework = resolveDocsFramework(Astro.params.framework);
const neutral = new Map<string, string>(Object.entries(neutralIcons));
const scaffold = new Map<string, string>(Object.entries(scaffoldIcons));
const compat = new Map<string, string>(Object.entries(compatIcons));

const icons = Object.entries(defaultIcons)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([htmlName, defaultSvg]) => {
    const base = htmlName.replace(/Icon$/, '');

    return {
      // Asset files spell `airplay` as one word, while export names capitalize `AirPlay`.
      name: base.replace(/^airPlay/, 'airplay').replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`),
      htmlName,
      reactName: `${base[0]!.toUpperCase()}${base.slice(1)}Icon`,
      defaultSvg,
      neutralSvg: neutral.get(htmlName) ?? "",
      compatSvg: compat.get(htmlName) ?? "",
      scaffoldSvg: scaffold.get(htmlName) ?? "",
    };
  });
---

<Table>
  <Thead>
    <Tr>
      {/* The previews are decorative SVGs, meaningless in the Markdown output. */}
      <Th data-llms-ignore>Default</Th>
      <Th data-llms-ignore>Neutral</Th>
      <Th data-llms-ignore>Compat</Th>
      <Th data-llms-ignore>Scaffold</Th>
      {framework === 'html' && <Th>Name</Th>}
      <Th>Export</Th>
    </Tr>
  </Thead>
  <Tbody>
    {
      icons.map((icon) => (
        <Tr>
          <Td data-llms-ignore>
            <span class="inline-flex size-4.5" set:html={icon.defaultSvg} />
            <span class="sr-only">{icon.name}, default set</span>
          </Td>
          <Td data-llms-ignore>
            <span class="inline-flex size-4.5" set:html={icon.neutralSvg} />
            <span class="sr-only">{icon.name}, neutral set</span>
          </Td>
          <Td data-llms-ignore>
            <span class="inline-flex size-4.5" set:html={icon.compatSvg} />
            <span class="sr-only">{icon.name}, compat set</span>
          </Td>
          <Td data-llms-ignore>
            <span class="inline-flex size-4.5" set:html={icon.scaffoldSvg} />
            <span class="sr-only">{icon.name}, scaffold set</span>
          </Td>
          {framework === 'html' && (
            <Td>
              <MarkdownCode>{icon.name}</MarkdownCode>
            </Td>
          )}
          <Td class="w-full">
            <MarkdownCode>{framework === 'html' ? icon.htmlName : icon.reactName}</MarkdownCode>
          </Td>
        </Tr>
      ))
    }
  </Tbody>
</Table>

