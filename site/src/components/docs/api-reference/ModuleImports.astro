---
import type { BundledLanguage } from 'shiki';

import ServerCode from '@/components/Code/ServerCode.astro';
import { Tab, TabsList, TabsPanel, TabsRoot } from '@/components/Tabs.tsx';
import { VJS10_CDN_BASE } from '@/consts';
import { kebabCase } from 'es-toolkit/string';
import FrameworkCase from '../FrameworkCase.astro';

interface Props {
  /** Module name: the suffix shared by the React, HTML, and CDN subpaths. */
  name: string;
  /** Package that ships the module's adapter or extension, installed beside the framework package. */
  package?: string;
  /** Whether the install command should include only the module package. */
  packageOnlyInstall?: boolean;
  /** Named export from the React module. */
  react: string;
  /** Public module family shared by the React, HTML, and CDN imports. */
  subpath: 'extensions' | 'media';
}

const { name, package: pkg, packageOnlyInstall = false, react, subpath } = Astro.props;

const cdnCode = `<script type="module" src="${VJS10_CDN_BASE}/${subpath}/${name}.js"></script>`;

type Framework = 'react' | 'html';
type ImportTab = { label: string; code: string; lang: BundledLanguage };

const install = (framework: Framework): ImportTab[] => {
  if (!pkg) return [];

  const code = packageOnlyInstall ? `pnpm add ${pkg}` : `pnpm add @videojs/${framework} ${pkg}`;

  return [{ label: 'Install', code, lang: 'bash' }];
};

// One tabbed frame per framework keeps the Import section short, so the Guides list stays near the top of the page.
const tabs: Record<Framework, ImportTab[]> = {
  react: [
    ...install('react'),
    { label: 'Import', code: `import { ${react} } from '@videojs/react/${subpath}/${name}';`, lang: 'tsx' },
  ],
  html: [
    ...install('html'),
    { label: 'Import', code: `import '@videojs/html/${subpath}/${name}';`, lang: 'ts' },
    { label: 'CDN', code: cdnCode, lang: 'html' },
  ],
};
---

{
  (['react', 'html'] as const).map((framework) => (
    <FrameworkCase frameworks={[framework]}>
      <TabsRoot client:idle>
        <TabsList client:idle label={`${name} import code`}>
          {tabs[framework].map(({ label }, index) => (
            <Tab client:idle value={kebabCase(label)} initial={index === 0}>
              {label}
            </Tab>
          ))}
        </TabsList>
        {tabs[framework].map(({ label, code, lang }, index) => (
          <TabsPanel client:idle value={kebabCase(label)} initial={index === 0}>
            <ServerCode code={code} lang={lang} />
          </TabsPanel>
        ))}
      </TabsRoot>
    </FrameworkCase>
  ))
}
