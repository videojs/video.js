---
import type { BundledLanguage } from 'shiki';

import ServerCode from '@/components/Code/ServerCode.astro';
import CodeFrame from '@/components/typography/CodeFrame.astro';
import P from '@/components/typography/P.astro';
import { VJS10_CDN_BASE } from '@/consts';
import DocsLink from '../DocsLink.astro';
import FrameworkCase from '../FrameworkCase.astro';

interface Props {
  /** Preset subpath the skin ships from: `video`, `audio`, `live-video`, `live-audio`, or `background`. */
  preset: string;
  /** Named export from `@videojs/react/<preset>`. */
  react: string;
  /** Whether this is the preset's neutral variant, shipped as `neutral-skin`. */
  neutral?: boolean;
}

const { preset, react, neutral = false } = Astro.props;
const module = neutral ? 'neutral-skin' : 'skin';
const bundle = preset === 'background' ? 'background' : `${preset}${neutral ? '-neutral' : ''}`;
const cdnCode = `<script type="module" src="${VJS10_CDN_BASE}/${bundle}.js"></script>`;

const imports: Array<{ code: string; framework: 'react' | 'html'; lang: BundledLanguage }> = [
  {
    code: `import { ${react} } from '@videojs/react/${preset}';\nimport '@videojs/react/${preset}/${module}.css';`,
    framework: 'react',
    lang: 'tsx',
  },
  {
    code: `import '@videojs/html/${preset}/${module}';`,
    framework: 'html',
    lang: 'ts',
  },
];
---

{
  imports.map(({ code, framework, lang }) => (
    <FrameworkCase frameworks={[framework]}>
      <CodeFrame lang={lang}>
        <ServerCode code={code} lang={lang} />
      </CodeFrame>
    </FrameworkCase>
  ))
}

<FrameworkCase frameworks={['html']}>
  <P>
    The import registers the skin and every UI element it composes. The <DocsLink slug="guides/cdn">CDN</DocsLink>{' '}
    player bundle registers this skin together with its player:
  </P>
  <CodeFrame lang="html">
    <ServerCode code={cdnCode} lang="html" />
  </CodeFrame>
</FrameworkCase>
