---
import { highlightInline } from '@/components/Code/inlineHighlighter';
import { resolveDocsFramework } from '@/types/docs';
import { renderInlineMarkdown, setInlineCodeHighlighter } from '@/utils/docs/renderInlineMarkdown';

interface Props {
  content?: string;
  fallback?: string;
}

const { content, fallback = '-' } = Astro.props;

setInlineCodeHighlighter((code) => highlightInline(code));

const framework = resolveDocsFramework(Astro.params.framework);
const html = content ? renderInlineMarkdown(content, { highlight: true, framework }) : fallback;
---

<Fragment set:html={html} />
