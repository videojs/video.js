---
import ArrowUpRight from '@/assets/icons/arrow-up-right.svg?react';
import ApiStabilityBadge from '@/components/docs/ApiStabilityBadge.astro';
import { getLinkDestination } from '@/components/typography/linkDestination';
import type { DocStability, SidebarItem as SidebarItemType, SupportedFramework } from '@/types/docs';
import { isLink, isSection } from '@/types/docs';
import { buildDocsUrl, isDocsGuideActive } from '@/utils/docs/routing';

/**
 * One flat sidebar entry. Depth 0 is a section heading inside the active tab, deeper sections render as sub-headings,
 * and guides render as links. Nothing collapses.
 */
type Props = {
  item: SidebarItemType;
  framework: SupportedFramework;
  docTitles: Map<string, string>;
  docStabilities: Map<string, DocStability | undefined>;
  depth?: number;
  /** View-transition name for the active link's indicator; see `DocsSidebar`. */
  indicatorTransitionName?: string;
};

const { item, framework, docTitles, docStabilities, depth = 0, indicatorTransitionName } = Astro.props;
const currentPath = Astro.url.pathname;
const isHidden = !isSection(item) && !isLink(item) && item.hidden === true;
const stability = !isSection(item) && !isLink(item) ? docStabilities.get(item.slug) : undefined;
const isActive = !isSection(item) && !isLink(item) && isDocsGuideActive(framework, item.slug, currentPath);

// The active indicator is a separate element rather than the link's own border so a view transition can move it.
const linkClass = [
  "relative -ml-px flex items-center gap-2 border-l border-transparent py-1.5 pl-4 text-p3 leading-5 select-none",
  isActive
    ? "font-semibold text-faded-black dark:text-manila-light"
    : "text-muted intent:border-line-strong intent:text-faded-black dark:intent:text-manila-light",
];
---

{
  isHidden ? null : isSection(item) ? (
    depth === 0 ? (
      <section class="mb-7 last:mb-0">
        <h3 class="mb-2 font-display text-h4 uppercase text-faded-black select-none dark:text-manila-light">
          {item.sidebarLabel}
        </h3>
        <ul class="border-l border-line">
          {item.contents.map((contentItem) => (
            <li>
              <Astro.self
                item={contentItem}
                framework={framework}
                docTitles={docTitles}
                docStabilities={docStabilities}
                depth={depth + 1}
                indicatorTransitionName={indicatorTransitionName}
              />
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <div class="mt-3 mb-1">
        <p
          class="py-1 pl-4 text-p4 font-semibold tracking-wide text-muted uppercase select-none"
          style={`padding-left: calc(var(--spacing) * ${depth * 4})`}
        >
          {item.sidebarLabel}
        </p>
        <ul>
          {item.contents.map((contentItem) => (
            <li>
              <Astro.self
                item={contentItem}
                framework={framework}
                docTitles={docTitles}
                docStabilities={docStabilities}
                depth={depth + 1}
                indicatorTransitionName={indicatorTransitionName}
              />
            </li>
          ))}
        </ul>
      </div>
    )
  ) : isLink(item) ? (
    <a
      class:list={linkClass}
      style={`padding-left: calc(var(--spacing) * ${depth * 4})`}
      href={item.href}
      data-ph-capture-attribute-destination={getLinkDestination(item.href)}
    >
      {item.devOnly ? "[Dev only] " : ""}
      <span class="min-w-0 flex-1">{item.sidebarLabel}</span>
      <ArrowUpRight className="size-4 shrink-0" aria-hidden="true" />
    </a>
  ) : (
    <a
      aria-current={isActive ? "page" : undefined}
      class:list={linkClass}
      data-docs-slug={item.slug}
      style={`padding-left: calc(var(--spacing) * ${depth * 4})`}
      href={buildDocsUrl(framework, item.slug)}
    >
      {isActive && (
        <span
          aria-hidden="true"
          data-docs-view-transition
          class="absolute inset-y-0 -left-px w-px bg-accent"
          style={indicatorTransitionName ? `view-transition-name: ${indicatorTransitionName}` : undefined}
        />
      )}
      {item.devOnly ? "[Dev only] " : ""}
      <span class="min-w-0 flex-1">
        {item.sidebarLabel || docTitles.get(item.slug) || item.slug}
      </span>
      {stability && <ApiStabilityBadge stability={stability} />}
    </a>
  )
}
