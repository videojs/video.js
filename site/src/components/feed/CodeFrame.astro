---
/**
 * Feed stand-in for the site's `CodeFrame`, which the `satteriCodeFrame` MDAST plugin wraps around every standalone
 * code block. The real frame is a set of React islands (tabs, copy button) that only work on the page.
 */
interface Props {
  title?: string;
  lang?: string;
}

const { title, lang } = Astro.props;
const label = title || lang;
---

<figure>
  {label && <figcaption>{label}</figcaption>}
  <slot />
</figure>
