---
import { GearIcon, PlayIcon } from '@videojs/react/icons';
import { Image } from 'astro:assets';

import cliffs from '@/assets/blog/2026-10-08-videojs-v10-skin-design/frosted-cosmic-cliffs.webp';
import Figure from '@/components/typography/Figure.astro';
import AnimationControls from '@/components/AnimationControls';
import { buttonStyle, iconStyle, imageSizes, imageWidths } from './demo';
import './Demo.css';

const examples = [
  { label: 'Proportional numerals', style: 'proportional-nums' },
  { label: 'Tabular numerals', style: 'tabular-nums' },
];
---

<Figure>
  <blog-time-demo class="@container relative block">
    <div class="space-y-6">
      {examples.map(({ label, style }) => (
        <div class="space-y-2">
          <p class="text-p3">{label}</p>
          <div class="relative isolate overflow-hidden rounded-3xl bg-black" style="aspect-ratio: 4 / 1;" role="presentation" aria-hidden="true">
            <Image src={cliffs} alt="" widths={imageWidths} sizes={imageSizes} quality={75} class="absolute inset-0 h-full w-full object-cover" />
            <div
              class="blog-demo-surface absolute top-1/2 flex -translate-y-1/2 items-center rounded-full bg-white/10 text-white"
              style="inset-inline: 4%; font-size: 5cqw; line-height: 1.5; --unit: calc(1em / 13); padding: calc(var(--unit) * 4);"
            >
              <span class="grid shrink-0 place-items-center rounded-full" style={buttonStyle}>
                <PlayIcon style={iconStyle} />
              </span>
              <div class="flex min-w-0 flex-1 items-center" style="gap: calc(var(--unit) * 10); padding: 0 calc(var(--unit) * 4);">
                <span data-time class:list={['shrink-0 whitespace-nowrap', style]}>1:08</span>
                <div class="relative flex-1 overflow-hidden rounded-full bg-white/15" style="height: calc(var(--unit) * 4);">
                  <div class="absolute inset-y-0 left-0 w-1/3 rounded-full bg-white/50" />
                </div>
              </div>
              <span class="grid shrink-0 place-items-center rounded-full" style={buttonStyle}>
                <GearIcon style={iconStyle} />
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
    <AnimationControls playing />
  </blog-time-demo>
  <figcaption>The same font, size, and timer. Tabular numerals keep each digit’s width steady as the time changes.</figcaption>
</Figure>

<script>
  import { connectDemoAnimation } from './demo';

  class TimeDemo extends HTMLElement {
    disconnect?: () => void;

    connectedCallback() {
      const times = this.querySelectorAll('[data-time]');
      let seconds = 8;
      let timer: ReturnType<typeof setInterval> | undefined;

      this.disconnect = connectDemoAnimation(this, {
        play: () => {
          timer ??= setInterval(() => {
            seconds = seconds === 19 ? 8 : seconds + 1;

            for (const time of times) time.textContent = `1:${String(seconds).padStart(2, '0')}`;
          }, 1000);
        },
        pause: () => {
          clearInterval(timer);
          timer = undefined;
        },
      });
    }

    disconnectedCallback() {
      this.disconnect?.();
    }
  }

  customElements.define('blog-time-demo', TimeDemo);
</script>
