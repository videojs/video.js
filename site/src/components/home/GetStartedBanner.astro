---
import clsx from 'clsx';
import ArrowIcon from '@/assets/icons/arrow.svg?react';
import GetStartedLink from '../NavBar/GetStartedLink';
---

<section class="mx-auto w-full max-w-360 px-5" data-ph-capture-attribute-location="get-started-banner">
  <div
    class="group relative mb-20 items-center overflow-hidden rounded-xl corner-squircle bg-orange py-2.5 text-center text-faded-black transition-colors duration-200 has-[a:hover]:text-manila-light lg:mb-24 lg:flex lg:text-left lg:duration-300"
  >
    <div
      class="absolute top-(--top) right-2.5 bottom-2.5 left-2.5 z-0 rounded-lg corner-squircle bg-faded-black duration-200 group-has-[a:hover]:top-2.5 lg:top-2.5 lg:left-(--lg-left) lg:duration-300 lg:group-has-[a:hover]:left-2.5"
      style={{
        "--top": "calc(100% - var(--spacing) * 15 - var(--spacing) * 2.5)",
        "--lg-left": "calc(100% - var(--spacing) * 40 - var(--spacing) * 2.5)",
        transitionProperty: "top, left",
      }}
    >
    </div>
    <h2
      class={clsx(
        "relative z-10 my-2.5 px-2.5 font-display text-h15 uppercase lg:m-0 lg:pr-14 lg:pl-9 xl:text-h1",
      )}
    >
      Get
      <br class="md:hidden" />
      <span class="hidden md:inline">{" "}</span>
      <span
        class="text-stroke-faded-black duration-200 group-has-[a:hover]:text-stroke-manila-light lg:duration-300"
        style={{ transitionProperty: "-webkit-text-stroke" }}>Started</span
      >
    </h2>
    <p
      class={clsx(
        "relative z-10 mb-8 px-2.5 text-p2 lg:mb-0 lg:max-w-54 lg:px-0",
      )}
    >
      Everything you need to install and launch your player
    </p>

    <GetStartedLink
      client:idle
      aria-label="Get started"
      data-ph-capture-attribute-cta="get-started"
      className={clsx(
        "relative z-10 ml-auto flex h-15 items-center justify-center text-orange lg:h-25 lg:w-40 lg:pr-2.5",
      )}
    >
      <ArrowIcon width="3.8rem" />
    </GetStartedLink>
  </div>
</section>
