---
import ArrowRight from '@/assets/icons/arrow-right.svg?react';
import { resolveDocsHref } from '@/utils/docs/routing';
import Header from '../Header.astro';
import StoryPlayer from './StoryPlayer';

import '@videojs/react/video/skin.css';
import '@videojs/react/video/neutral-skin.css';
import '@videojs/react/video/compat-skin.css';
import '@videojs/react/video/scaffold-skin.css';
import '@videojs/react/background/skin.css';
import '@videojs/react/live-video/skin.css';
import '@videojs/react/audio/skin.css';
import './Story.css';

interface Props {
  poster: string;
}

const { poster } = Astro.props;

const steps = [
  {
    eyebrow: 'Composable',
    title: 'Every skin comes apart',
    body: 'A skin is a stack of layers you can use yourself: the media, the poster, the backdrop, the controls, and the popups above them. Swap any layer, or leave it out.',
  },
  {
    eyebrow: 'Primitives',
    title: 'Every control is a component',
    body: 'Play, mute, time, scrubbing, fullscreen. Each control is its own component with its state and accessibility built in, so you can rearrange, restyle, or remove any of them.',
  },
  {
    eyebrow: 'Accessible',
    title: 'Ready for every input',
    body: 'Every control carries its role, name, and state. Menus and popovers move with the arrow keys, keep focus where it belongs, and describe each item to screen readers.',
  },
  {
    eyebrow: 'Own the source',
    title: 'Make it yours',
    body: 'Start with a packaged skin. When you need more, add its source to your project and change it like your own code, down to the last button.',
    aside: {
      label: 'See the packaged setup',
      href: resolveDocsHref({ slug: 'guides/installation', framework: null }),
    },
    link: {
      label: 'Customize a skin',
      href: `${resolveDocsHref({ slug: 'guides/customize-skins', framework: null })}#style-skin-source`,
    },
  },
];
---

<section data-story class="story relative mb-24 md:mb-32">
  <div class="story-track mx-auto w-full max-w-360 px-5" data-ph-capture-attribute-location="hero">
    <Header />

    <div class="story-sticky">
      <StoryPlayer client:load poster={poster} />
    </div>

    <ol class="story-steps" data-ph-capture-attribute-location="composition">
      {
        steps.map(({ eyebrow, title, body, aside, link }, index) => (
          <li class="story-step" data-story-step={index}>
            <div class="story-step-card">
              <p class="mb-3 font-display text-p4 text-muted uppercase">
                {`${eyebrow} · ${String(index + 1).padStart(2, '0')} / ${String(steps.length).padStart(2, '0')}`}
              </p>
              <h2 class="mb-3 font-display text-h25 text-balance uppercase lg:text-h2">{title}</h2>
              <p class="text-p2">{body}</p>
              {aside && (
                <p class="mt-3 text-p3">
                  <a
                    class="underline intent:decoration-gold"
                    href={aside.href}
                    data-ph-capture-attribute-cta="packaged-setup"
                    data-ph-capture-attribute-destination="docs"
                  >
                    {aside.label}
                  </a>
                </p>
              )}
              {link && (
                <a
                  class="group mt-6 inline-flex items-center gap-2 font-display text-h4 uppercase"
                  href={link.href}
                  data-ph-capture-attribute-cta="customize-skin"
                  data-ph-capture-attribute-destination="docs"
                >
                  {link.label}
                  <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  /*
   * Drive the story from scroll position. `--handover` swaps the looks for the breakdown as the intro leaves; the
   * breakdown phases then follow the steps. Reduced motion jumps between the finished state of each stage instead.
   */
  const section = document.querySelector<HTMLElement>('[data-story]');
  const intro = document.querySelector<HTMLElement>('[data-hero]');
  const steps = [...document.querySelectorAll<HTMLElement>('[data-story-step]')];
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  // Progress values that show each step's finished state.
  const stepProgress = [0.12, 0.4, 0.65, 1];
  // How much scrolling, as a share of the viewport, the handover to the breakdown takes.
  const HANDOVER_SPAN = 0.6;
  // Beside the player, the intro starts to hand over as soon as it leaves; above it, once it has gone and the player pins.
  const besideIntro = matchMedia('(width >= 64rem)');

  /** 0 before `start`, 1 after `end`, eased in between. */
  const ramp = (value: number, start: number, end: number) => {
    const t = Math.min(1, Math.max(0, (value - start) / (end - start)));

    return t * t * (3 - 2 * t);
  };

  if (section && intro && steps.length) {
    let frame = 0;

    const update = () => {
      frame = 0;

      const middle = innerHeight / 2;
      let active = -1;

      steps.forEach((step, index) => {
        if (step.getBoundingClientRect().top < middle) active = index;
      });
      steps.forEach((step, index) => step.toggleAttribute('data-active', index === Math.max(0, active)));

      const introLeft = (besideIntro.matches ? innerHeight : 0) - intro.getBoundingClientRect().bottom;
      const handoverSpans = introLeft / (innerHeight * HANDOVER_SPAN);
      const handedOver = Math.min(1, Math.max(0, handoverSpans));
      const first = steps[0]!.getBoundingClientRect();
      const last = steps.at(-1)!.getBoundingClientRect();
      const scrolled = Math.min(1, Math.max(0, (middle - first.top) / (last.bottom - first.top)));
      const motion = !reducedMotion.matches;
      const p = motion ? scrolled : active < 0 ? 0 : stepProgress[active]!;
      const phases = {
        handover: motion ? ramp(handedOver, 0, 1) : Math.round(handedOver),
        // The layers start lifting before the handover ends and keep going well past it, so the split reads slowly.
        tilt: (motion ? ramp(handoverSpans, 0.5, 1.2) : ramp(p, 0.05, 0.11)) * (1 - ramp(p, 0.2, 0.28)),
        spread: ramp(p, 0.22, 0.32),
        menus: ramp(p, 0.48, 0.57) * (1 - ramp(p, 0.74, 0.8)),
        // The bar docks back over the video as the menus open, and stays there once they close.
        dock: ramp(p, 0.48, 0.57),
        own: ramp(p, 0.77, 0.84),
      };

      for (const [name, value] of Object.entries(phases)) {
        section.style.setProperty(`--${name}`, value.toFixed(4));
      }

      // The restyle's corner shape and shadows can't interpolate, so they switch once it is halfway in.
      section.toggleAttribute('data-own', phases.own > 0.5);

      // Untilted, the layers are flat; the stylesheet drops the 3D context then so the popups' glass can blur.
      section.toggleAttribute('data-flat', phases.tilt === 0);
    };

    const schedule = () => {
      frame ||= requestAnimationFrame(update);
    };

    update();
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
  }
</script>
