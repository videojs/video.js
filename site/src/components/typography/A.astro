---
import type { HTMLTag, Polymorphic } from 'astro/types';
import { twMerge } from '@/utils/twMerge';

import { getLinkDestination } from './linkDestination';
import { shared } from './styles';

type Props<Tag extends HTMLTag = 'a'> = Polymorphic<{ as: Tag }> & {
  class?: string;
};

const { as: Tag = 'a', class: className, ...props } = Astro.props;
const destination = Tag === 'a' ? getLinkDestination(props.href) : undefined;
---

<Tag class={twMerge(shared.a, className)} data-ph-capture-attribute-destination={destination} {...props}><slot /></Tag>
