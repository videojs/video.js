---
import CollapsibleCode from '@/components/CollapsibleCode';
import CopyButton from '@/components/CopyButton';
import P from '@/components/typography/P.astro';

interface Props {
  prompt: string;
}

const { prompt } = Astro.props;
---

<P>Paste this prompt into your coding agent:</P>

<div
  class="mx-auto my-6 max-w-3xl overflow-hidden rounded-xl corner-squircle border border-line bg-surface shadow-xs"
  data-agent-prompt-card
>
  <div class="relative bg-soot">
    <CollapsibleCode client:idle fadeClassName="from-soot" scrollTarget="[data-agent-prompt-card]">
      <pre class="m-0 overflow-x-auto whitespace-pre-wrap wrap-anywhere bg-soot p-5"><code
          class="font-mono text-code leading-relaxed text-manila-light"
          data-agent-prompt>{prompt}</code
        ></pre>
    </CollapsibleCode>
  </div>
  <div class="flex justify-end border-t border-line bg-surface-raised p-3" data-llms-ignore>
    <CopyButton
      client:idle
      analytics={{ block: 'agent-prompt' }}
      copyFrom={{ container: '[data-agent-prompt-card]', target: '[data-agent-prompt]' }}
      className="inline-flex h-9 cursor-pointer items-center rounded-lg corner-squircle border border-line bg-surface px-3 text-p3 font-semibold shadow-xs select-none intent:border-line-strong intent:bg-hover focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-gold disabled:cursor-wait"
      copied="Copied"
      copiedCheck
      cta="copy-agent-prompt"
    >
      Copy prompt
    </CopyButton>
  </div>
</div>
