---
import { Font } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { PRERELEASE_URL, PRODUCTION_URL, SITE_TITLE, THEME_COLORS } from '@/consts';

import '@/styles/globals.css';

import BannerInit from '@/components/BannerInit.astro';
import { PreferenceSync } from '@/components/docs/PreferenceSync';
import ResolveDocsLinks from '@/components/docs/ResolveDocsLinks.astro';
import FooterEasterEgg from '@/components/FooterEasterEgg.astro';
import PlatformInit from '@/components/PlatformInit.astro';
import Posthog from '@/components/Posthog.astro';
import PrereleaseBanner from '@/components/PrereleaseBanner.astro';
import ThemeInit from '@/components/ThemeInit.astro';
import { buildPageTitle } from '@/utils/seo/title';

interface Props {
  title: string | string[];
  description: string;
  image?: ImageMetadata | string;
  twitterImage?: ImageMetadata | string;
  canonical?: string;
  /** SEO title suffix. Pass `false` to keep the title to `Page | Video.js`. */
  suffix?: string | false;
  /**
   * Pin the color-block easter egg behind the page so it is only revealed when the document rubber-bands past its
   * end. The page content is painted above it, so nothing shows until the user overscrolls.
   */
  easterEgg?: boolean | 'thin';
  /** Extra classes for the pinned color blocks, for example to keep them under one column of a layout. */
  easterEggClass?: string;
}
const { canonical, suffix, easterEgg = false, easterEggClass } = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, PRODUCTION_URL).href;

const { title, description, image, twitterImage } = Astro.props;

function resolveImageUrl(img: ImageMetadata | string): string {
  if (typeof img === 'string') return img;

  return new URL(img.src, Astro.url).toString();
}

// Auto-derive OG image URLs from the page pathname.
// Each prop is independent — `twitterImage` can override the Twitter card
// without requiring `image` to also be set.
const slug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '') || 'index';
const autoOgImage = new URL(`/og/${slug}.png`, Astro.site).toString();
const autoTwitterImage = new URL(`/og/twitter/${slug}.png`, Astro.site).toString();

const resolvedOgImage = image ? resolveImageUrl(image) : autoOgImage;
const resolvedTwitterImage = twitterImage
  ? resolveImageUrl(twitterImage)
  : image
    ? resolveImageUrl(image)
    : autoTwitterImage;

const fullTitle = buildPageTitle(title, suffix);
---

<html lang="en">
  <head>
    {/* Global Metadata */}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content={THEME_COLORS.light} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL("rss.xml", Astro.site)}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="algolia-site-verification" content="9CE2D1D6448256D3" />
    {
      Astro.site?.origin !== PRODUCTION_URL.origin && (
        <meta name="robots" content="noindex" />
      )
    }

    {/* Analytics on videojs.org and the pre-release site only, so deploy previews stay out of the data */}
    {import.meta.env.PROD && [PRODUCTION_URL.origin, PRERELEASE_URL.origin].includes(Astro.site?.origin ?? '') && <Posthog />}

    {/* Important stuff */}
    <slot name="priority-head" />

    {/* Preconnect to Mux for faster video/image loading */}
    <link rel="preconnect" href="https://image.mux.com" crossorigin />
    <link rel="preconnect" href="https://stream.mux.com" crossorigin />

    {/* Font preloads */}
    <Font cssVariable="--font-instrument-sans" preload />
    <Font cssVariable="--font-ibm-plex-mono" preload />
    {/*
      Eurostile is served from Mux's font host. Preloading it opened a third-party connection that competed with the
      page's own critical requests; the metric-matched fallbacks in globals.css swap to it without reflow, so warm the
      connection instead.
    */}
    <link rel="preconnect" href="https://static.mux.com" crossorigin />

    {/* Canonical URL */}
    <link rel="canonical" href={canonicalURL} />

    {/* Primary Meta Tags */}
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, PRODUCTION_URL)}
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta
      property="twitter:url"
      content={new URL(Astro.url.pathname, PRODUCTION_URL)}
    />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedTwitterImage} />

    {/* Whatever else */}
    <slot name="head" />

    <ThemeInit />
    <PlatformInit />
    <BannerInit />
  </head>
  <body
    class:list={[
      "relative",
      "font-sans text-p2 text-pretty",
      "bg-manila-light text-faded-black dark:bg-faded-black dark:text-manila-light",
      "min-w-80",
      "selection:bg-gold selection:text-faded-black",
    ]}
  >
    {
      easterEgg && (
        <FooterEasterEgg
          fixed
          variant={easterEgg === "thin" ? "extra-short" : "normal"}
          class={easterEggClass}
          data-overscroll-reveal
        />
      )
    }
    <div
      class:list={[
        // BaseUI requires body.relative and div.isolate
        "isolate",
        // Opaque and stacked above the fixed easter egg so it only peeks out on overscroll
        "relative z-0 min-h-screen bg-manila-light dark:bg-faded-black",
      ]}
      data-overscroll-page
    >
      <a
        href="#main-content"
        class="sr-only bg-manila-light font-display text-h3 text-faded-black uppercase focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-50 focus:px-4 focus:py-2 dark:bg-faded-black dark:text-manila-light"
      >
        Skip to content
      </a>
      <PreferenceSync client:idle />
      <ResolveDocsLinks />

      <div
        data-banner-container
        data-astro-transition-persist="site-banners"
        class="sticky top-0 z-40"
      >
        <PrereleaseBanner />
      </div>
      <slot />
    </div>
    {
      easterEgg && (
        <script is:inline>
          // Amplified overscroll: a trackpad's native rubber-band only moves a few pixels, and Chrome has none, so at
          // the end of the page wheel deltas slide the page up over the pinned color blocks and it springs back when
          // the gesture stops. Touch devices keep the browser's own rubber-band, which already reveals them.
          (() => {
            let offset = 0;
            let releaseTimer;
            // The reveal only arms on a fresh gesture that starts while the page is already at its end. A fast scroll
            // that lands on the end keeps delivering wheel events without a gap, and those must not pull.
            let lastWheelAt = 0;
            const GESTURE_GAP_MS = 250;

            const atPageEnd = () =>
              window.innerHeight + window.scrollY >=
              document.documentElement.scrollHeight - 1;

            const apply = () => {
              const page = document.querySelector("[data-overscroll-page]");
              if (!page) return;

              page.style.transition = "none";
              page.style.transform = offset ? `translate3d(0, ${-offset}px, 0)` : "";
            };

            const release = () => {
              const page = document.querySelector("[data-overscroll-page]");
              if (!page) return;

              offset = 0;
              page.style.transition = "transform 600ms var(--ease-soft)";
              page.style.transform = "";
            };

            window.addEventListener(
              "wheel",
              (event) => {
                const now = performance.now();
                const freshGesture = now - lastWheelAt > GESTURE_GAP_MS;

                lastWheelAt = now;

                const pulling = event.deltaY > 0 && atPageEnd() && (freshGesture || offset > 0);
                if (!pulling && offset === 0) return;

                const reveal = document.querySelector("[data-overscroll-reveal]");
                if (!reveal) return;

                const max = reveal.offsetHeight;
                // Ease off as the blocks come fully into view so the pull feels elastic rather than linear.
                const resistance = 1 - (offset / max) * 0.6;

                offset = Math.min(max, Math.max(0, offset + event.deltaY * resistance));
                apply();

                clearTimeout(releaseTimer);
                releaseTimer = setTimeout(release, 180);
              },
              { passive: true },
            );
          })();
        </script>
      )
    }
  </body>
</html>
