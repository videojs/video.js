---

import { ClientRouter } from 'astro:transitions';
import { type CollectionEntry, getCollection } from 'astro:content';
import DocsSidebar from '@/components/docs/DocsSidebar.astro';
import DocsSidebarRestoration from '@/components/docs/DocsSidebarRestoration.astro';
import InstallationFrameworkInit from '@/components/installation/InstallationFrameworkInit.astro';
import { PreferenceUpdater } from '@/components/docs/PreferenceUpdater';
import { Selectors } from '@/components/docs/Selectors';
import StyleInit from '@/components/docs/StyleInit.astro';
import Footer from '@/components/FooterDocs.astro';
import MarkdownAlternate from '@/components/MarkdownAlternate.astro';
import NavBarDocs from '@/components/NavBar/NavBarDocs.astro';
import { FRAMEWORK_LABELS, type SupportedFramework } from '@/types/docs';
import { getDocTitle } from '@/utils/docs/title';
import { getInstallationRouteSegment } from '@/utils/installation/routes';
import Base from './Base.astro';

type Props = {
  doc: CollectionEntry<'docs'>;
  description?: string;
  framework: SupportedFramework;
  frameworks?: readonly SupportedFramework[];
  slug: string;
  registryFrameworkSelection?: boolean;
  conciseMetadata?: boolean;
};

const {
  doc,
  description = doc.data.description,
  framework,
  frameworks = [framework],
  slug,
  registryFrameworkSelection = false,
  conciseMetadata = false,
} = Astro.props;

// Fetch all docs to get their framework-specific titles
const allDocs = await getCollection('docs');
const sidebarFrameworks = registryFrameworkSelection ? frameworks : [framework];
const docTitlesByFramework = new Map(
  sidebarFrameworks.map((candidate) => [
    candidate,
    new Map(allDocs.map((doc) => [doc.id, getDocTitle(doc, candidate)])),
  ])
);
const docStabilities = new Map(allDocs.map((d) => [d.id, d.data.stability]));

const seoCategory = `${FRAMEWORK_LABELS[framework]} Video Player`;
const docsSidebarId = 'docs-sidebar';
// A client navigation from another docs page runs the guide's inline script right after the swap, before the next
// frame, so only installation guides need to carry it.
const isInstallationGuide = getInstallationRouteSegment(Astro.url.pathname) !== null;
---

<Base
  title={getDocTitle(doc, framework)}
  suffix={conciseMetadata ? false : `Open Source ${FRAMEWORK_LABELS[framework]} Video Player`}
  description={conciseMetadata ? description : `${description} — Video.js ${seoCategory}.`}
  easterEgg="thin"
  easterEggClass="md:left-70 lg:left-75"
>
  <Fragment slot="priority-head">
    <StyleInit />
    {isInstallationGuide && <InstallationFrameworkInit />}
    <ClientRouter />
  </Fragment>
  <Fragment slot="head">
    <DocsSidebarRestoration />
    <MarkdownAlternate />
    <slot name="head" slot="head" />
  </Fragment>
  <PreferenceUpdater client:idle currentFramework={framework} />
  <div
    data-docs-layout
    class:list={[
      "grid grid-cols-1",
      "md:grid-cols-(--md-grid-cols) lg:grid-cols-(--lg-grid-cols)",
    ]}
    style={{
      "--md-grid-cols": `calc(var(--spacing) * 70) minmax(0,1fr)`,
      "--lg-grid-cols": `calc(var(--spacing) * 75) minmax(0,1fr)`,
      "grid-template-rows": "auto minmax(0,1fr)",
      "min-height": "calc(100vh - var(--banner-height))",
    }}
  >
    <NavBarDocs class="col-span-full">
      {
        sidebarFrameworks.map((sidebarFramework) => (
          <div
            slot="mobile-nav"
            class="contents"
            data-shadcn-framework={registryFrameworkSelection ? sidebarFramework : undefined}
          >
            <DocsSidebar
              framework={sidebarFramework}
              docTitles={docTitlesByFramework.get(sidebarFramework)!}
              docStabilities={docStabilities}
            >
              <Selectors
                client:idle
                currentFramework={sidebarFramework}
                currentSlug={slug}
                registryFrameworkSelection={registryFrameworkSelection}
              />
            </DocsSidebar>
          </div>
        ))
      }
    </NavBarDocs>
    <aside
      id={docsSidebarId}
      class="scrollbar-thin sticky z-10 hidden flex-col overflow-y-scroll border-line md:flex md:border-r"
      style="top: calc(var(--banner-height) + var(--nav-h)); max-height: calc(100vh - var(--banner-height) - var(--nav-h));"
    >
      {
        sidebarFrameworks.map((sidebarFramework) => (
          <div
            class="contents"
            data-shadcn-framework={registryFrameworkSelection ? sidebarFramework : undefined}
          >
            <DocsSidebar
              framework={sidebarFramework}
              docTitles={docTitlesByFramework.get(sidebarFramework)!}
              docStabilities={docStabilities}
              class="flex-1"
              animateIndicator
            >
              <Selectors
                client:idle
                currentFramework={sidebarFramework}
                currentSlug={slug}
                registryFrameworkSelection={registryFrameworkSelection}
              />
            </DocsSidebar>
          </div>
        ))
      }
    </aside>
    <div>
      <div
        class="vt-page flex flex-col"
        style="min-height:calc(100vh - var(--banner-height) - var(--nav-h));"
      >
        <slot />
      </div>
      <Footer class="mt-auto" />
    </div>
  </div>
</Base>
