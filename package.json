{
  "name": "@videojs/monorepo",
  "version": "0.1.0",
  "description": "Video.js 10 Monorepo",
  "license": "Apache-2.0",
  "author": "Video.js Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/video.js.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "postinstall": "node build/scripts/link-aliases.mjs",
    "build:packages": "vp run --fail-if-no-match --filter='./packages/**' --filter='!@videojs/cdn' build",
    "build:sandbox": "vp run @videojs/sandbox#build",
    "build:cdn": "vp run @videojs/cdn#build:cdn",
    "build:shadcn": "vp run @videojs/skins#build:shadcn",
    "build:site": "vp run site#build",
    "build": "vp run -r build",
    "clean": "vp run -r --no-cache clean",
    "commitlint": "commitlint --config ./commitlint.config.js --edit",
    "dev:site": "node --import tsx site/scripts/dev.ts",
    "dev": "pnpm dev:prepare && VP_PACK_WATCH=true vp run --fail-if-no-match --filter='./packages/**' --filter='./apps/*' --filter='./site' --parallel --ignore-depends-on --no-cache dev",
    "dev:prepare": "vp run -w prepare:dev",
    "dev:packages": "vp run --fail-if-no-match --filter='./packages/**' build && VP_PACK_WATCH=true vp run --fail-if-no-match --filter='./packages/**' --parallel --ignore-depends-on --no-cache dev",
    "dev:sandbox": "vp run @videojs/sandbox#dev",
    "dev:sandbox:https": "vp run @videojs/sandbox#dev:https",
    "lint": "vp check --no-lint && vp lint --quiet",
    "lint:anti-slop": "vp lint",
    "lint:fix": "vp check --fix",
    "lint:fix:file": "vp check --fix --no-error-on-unmatched-pattern",
    "link:aliases": "node build/scripts/link-aliases.mjs",
    "size": "node .github/scripts/bundle-size.js | node .github/scripts/bundle-size-report.js",
    "test": "vp run --fail-if-no-match --filter='./packages/**' test:ci",
    "test:e2e": "pnpm --dir apps/e2e test:all",
    "test:e2e:vite": "pnpm --dir apps/e2e test:vite",
    "test:e2e:drm": "vp run '@videojs/e2e#test:drm'",
    "test:e2e:sandbox": "vp run '@videojs/e2e#test:sandbox'",
    "test:e2e:skins": "vp run '@videojs/e2e#test:skin-parity'",
    "test:e2e:registry": "vp run '@videojs/e2e#test:registry'",
    "test:e2e:registry:published": "vp run '@videojs/e2e#test:registry:published'",
    "test:e2e:update": "pnpm --dir apps/e2e test:update",
    "test:e2e:install": "pnpm --dir apps/e2e run install:browsers && pnpm --dir apps/e2e run install:deps",
    "test:shadcn": "vp run @videojs/skins#validate:shadcn",
    "test:size": "node --test .github/scripts/tests/*.test.js",
    "format": "vp fmt --write",
    "format:astro": "vp fmt 'site/src/**/*.astro' --write",
    "typecheck": "vp run typecheck:workspace",
    "changelog": "node build/scripts/generate-changelog.mjs",
    "check:workspace": "node build/scripts/check-workspace.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/format": "^20.0.0",
    "@types/node": "^22.18.6",
    "@typescript/native-preview": "beta",
    "@vitejs/plugin-react": "^6.1.1",
    "browserslist": "^4.29.0",
    "esbuild": "^0.28.1",
    "git-cliff": "^2.12.0",
    "lightningcss": "^1.32.0",
    "magic-string": "^1.2.2",
    "oxc-transform-react": "0.145.0",
    "pkg-pr-new": "^0.0.88",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "vite-plus": "catalog:"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 121",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "and_chr >= 111",
    "and_ff >= 121",
    "samsung >= 22",
    "opera >= 98"
  ],
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.9.3"
  },
  "packageManager": "pnpm@12.6.0"
}
