def api_flux_v2(prompt, seed=None):
    """Flux Schnell v2 - Rapidité extrême"""
    enc = urllib.parse.quote(prompt[:200])
    p = {"model": "flux-schnell", "width": "1024", "height": "1024", "seed": str(seed) if seed else ""}
    url = "https://image.pollinations.ai/prompt/" + enc + "?" + urllib.parse.urlencode(p)
    # ... même logique que api_flux
    return {"ok": True, "data": data, "api": "flux_v2"}

