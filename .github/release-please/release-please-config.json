{
  "release-as": "10.0.0",
  "tag-separator": "@",
  "include-component-in-tag": true,
  "include-v-in-tag": false,
  "plugins": [
    {
      "type": "node-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "videojs",
      "components": [
        "@videojs/cdn",
        "@videojs/cli",
        "@videojs/cloudflare-video",
        "@videojs/core",
        "@videojs/dash-video",
        "@videojs/element",
        "@videojs/google-cast",
        "@videojs/hlsjs-video",
        "@videojs/html",
        "@videojs/icons",
        "@videojs/installation",
        "@videojs/media",
        "@videojs/mux-audio",
        "@videojs/mux-data",
        "@videojs/mux-video",
        "@videojs/native-hls-video",
        "@videojs/react",
        "@videojs/shaka-video",
        "@videojs/skins",
        "@videojs/spf",
        "@videojs/spotify-audio",
        "@videojs/store",
        "@videojs/tiktok-video",
        "@videojs/twitch-video",
        "@videojs/utils",
        "@videojs/vimeo-video",
        "@videojs/wistia-video",
        "@videojs/youtube-video",
        "video.js"
      ]
    }
  ],
  "packages": {
    "packages/cdn": {
      "component": "@videojs/cdn"
    },
    "packages/cli": {
      "component": "@videojs/cli"
    },
    "packages/adapters/cloudflare-video": {
      "component": "@videojs/cloudflare-video"
    },
    "packages/core": {
      "component": "@videojs/core"
    },
    "packages/adapters/dash-video": {
      "component": "@videojs/dash-video"
    },
    "packages/element": {
      "component": "@videojs/element"
    },
    "packages/extensions/google-cast": {
      "component": "@videojs/google-cast"
    },
    "packages/adapters/hlsjs-video": {
      "component": "@videojs/hlsjs-video"
    },
    "packages/html": {
      "component": "@videojs/html"
    },
    "packages/icons": {
      "component": "@videojs/icons"
    },
    "packages/installation": {
      "component": "@videojs/installation"
    },
    "packages/media": {
      "component": "@videojs/media"
    },
    "packages/adapters/mux-audio": {
      "component": "@videojs/mux-audio"
    },
    "packages/extensions/mux-data": {
      "component": "@videojs/mux-data"
    },
    "packages/adapters/mux-video": {
      "component": "@videojs/mux-video"
    },
    "packages/adapters/native-hls-video": {
      "component": "@videojs/native-hls-video"
    },
    "packages/react": {
      "component": "@videojs/react"
    },
    "packages/adapters/shaka-video": {
      "component": "@videojs/shaka-video"
    },
    "packages/skins": {
      "component": "@videojs/skins"
    },
    "packages/spf": {
      "component": "@videojs/spf"
    },
    "packages/adapters/spotify-audio": {
      "component": "@videojs/spotify-audio"
    },
    "packages/store": {
      "component": "@videojs/store"
    },
    "packages/adapters/tiktok-video": {
      "component": "@videojs/tiktok-video"
    },
    "packages/adapters/twitch-video": {
      "component": "@videojs/twitch-video"
    },
    "packages/utils": {
      "component": "@videojs/utils"
    },
    "packages/adapters/vimeo-video": {
      "component": "@videojs/vimeo-video"
    },
    "packages/adapters/wistia-video": {
      "component": "@videojs/wistia-video"
    },
    "packages/adapters/youtube-video": {
      "component": "@videojs/youtube-video"
    },
    "packages/video.js": {
      "component": "video.js"
    }
  }
}
