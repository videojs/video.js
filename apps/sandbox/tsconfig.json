{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "composite": false,
    "noEmit": true,
    "paths": {
      "@app/*": ["./app/*"],
      "@registry-react-tailwind-default/*": ["./app/_generated/registry/react-tailwind-default/*"],
      "@registry-react-tailwind-neutral/*": ["./app/_generated/registry/react-tailwind-neutral/*"],
      "@registry-react-tailwind-compat/*": ["./app/_generated/registry/react-tailwind-compat/*"],
      "@registry-react-css-default/*": ["./app/_generated/registry/react-css-default/*"],
      "@registry-react-css-neutral/*": ["./app/_generated/registry/react-css-neutral/*"],
      "@registry-react-css-compat/*": ["./app/_generated/registry/react-css-compat/*"],
      "@registry-html-default/*": ["./app/_generated/registry/html-default/*"],
      "@registry-html-neutral/*": ["./app/_generated/registry/html-neutral/*"],
      "@registry-html-compat/*": ["./app/_generated/registry/html-compat/*"]
    }
  },
  "include": ["app", "src", "templates", "scripts", "types"],
  "exclude": ["node_modules", "dist"]
}
