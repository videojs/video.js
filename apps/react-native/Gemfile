source 'https://rubygems.org'

# Ruby version is managed by mise — see mise.toml.
ruby ">= 4.0.0"

# Pinned to match mise.toml's `gem:cocoapods`. `react-native run-ios` runs pod
# through `bundle exec` when this Gemfile exists, so a mismatch here means the
# CLI and a direct `pod install` use different CocoaPods and fight over
# Podfile.lock. The template's `xcodeproj < 1.26.0` / `concurrent-ruby < 1.3.4`
# caps were removed because they hold CocoaPods down to 1.15.2.
gem 'cocoapods', '1.17.0'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'

# Ruby 3.4.0 removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
