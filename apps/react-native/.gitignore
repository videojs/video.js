# Patterns specific to this app's native builds. Repo-wide ignores
# (node_modules, .DS_Store, Pods/) live in the root .gitignore — but its
# `android/build/`-style patterns are anchored to the repo root, so the native
# output directories below must be re-declared here.

# Xcode
build/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.xcuserstate
xcuserdata
DerivedData
project.xcworkspace
**/.xcode.env.local

# Android / Gradle
.cxx
.gradle
local.properties
*.iml
*.hprof

# CocoaPods / Ruby
ios/Pods
ios/*.xcworkspace
vendor/

# Metro
.metro-health-check*

# React Native Codegen
ios/generated
android/generated
