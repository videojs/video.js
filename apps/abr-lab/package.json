{
  "name": "@videojs/abr-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Exploratory spike: log real segment transfers and score throughput predictors against them.",
  "type": "module",
  "scripts": {
    "logger": "vp dev",
    "record": "node --import tsx src/cli/record.ts",
    "synth": "node --import tsx src/cli/synth.ts",
    "score": "node --import tsx src/cli/score.ts",
    "test": "vp test run",
    "typecheck": "tsgo --project tsconfig.json --noEmit",
    "passes": "node --import tsx src/cli/passes.ts",
    "train": "node --import tsx src/cli/train.ts",
    "probe": "node --import tsx src/cli/probe.ts",
    "lab:up": "docker compose -f netlab/compose.yaml up -d --build",
    "lab:down": "docker compose -f netlab/compose.yaml down",
    "probe:report": "node --import tsx src/cli/probe-report.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "playwright-core": "^1.52.0",
    "tsx": "^4.23.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
