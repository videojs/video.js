{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": false,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "vite.config.ts"],
  "exclude": ["**/node_modules/**"]
}
